# Public URL of the site. Vercel subdomain first, custom domain later.
NEXT_PUBLIC_SITE_URL=https://brissiabenavente.com

# Newsletter: form endpoint of the provider (Buttondown or Beehiiv embed URL).
# Example for Buttondown: https://buttondown.com/api/emails/embed-subscribe/YOUR_USERNAME
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Privacy-friendly analytics. Leave empty to disable.
# Plausible: src=https://plausible.io/js/script.js  domain=brissiabenavente.com
# Umami:     src=https://your-umami-host/script.js   website id goes in ANALYTICS_ID
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_ID=
